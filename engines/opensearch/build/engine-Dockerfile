# AI-Powered Search OpenSearch engine image.
#
# Built on the official OpenSearch distribution image. As of OpenSearch 2.19
# the Learning to Rank plugin (opensearch-ltr) ships with the distribution,
# and as of 3.1 so does User Behavior Insights (opensearch-ubi), so neither
# plugin needs to be installed separately anymore.
ARG OS_VERSION=3.8.0
FROM opensearchproject/opensearch:${OS_VERSION}

# Quieter, console-only logging for the notebooks environment
COPY log4j2.properties /usr/share/opensearch/config/log4j2.properties
